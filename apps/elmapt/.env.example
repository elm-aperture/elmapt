# Copy to .env.local. .env.local is git-ignored.
#
# Where the photographs are. They are not part of this app and never built
# into it — they live on Firebase Hosting as a bare directory of directories,
# and this is the address of it. Absolute URL, no trailing slash. The app
# appends the same paths it always has:
#
#   {category}/{set}/{rung}/{file}.webp
#
#   VITE_RES_BASE=https://elmapt.web.app
#
# Leave it empty and dev falls back to /res/img — the symlink under
# apps/elmapt/public/res — so a fresh checkout runs with no setup at all. A
# production build refuses to run without it, on the grounds that a
# photography site with no photographs in it should fail loudly rather than
# deploy.

VITE_RES_BASE=
